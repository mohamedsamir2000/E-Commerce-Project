<?xml version="1.0" encoding="UTF-8"?>
<!-- Each run writes logs/automation_<date>_<time>.log; the console shows warnings and errors only -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %c{1} - %msg%n"/>
            <ThresholdFilter level="WARN"/>
        </Console>
        <File name="RunLog" fileName="logs/automation_${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %c{1} - %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="com.core" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RunLog"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
